// Woven Protocol version 1.
//
// Scalar IDs use 0 to mean absent or not assigned on the wire. Namespace,
// session, and space IDs may therefore be 0 only when the message semantics do
// not require that scope. Entity IDs, correlation IDs, payload type IDs,
// subscription IDs, channel IDs, epochs, ticks, and sequences follow the same
// convention. Assigned IDs and established epochs start at 1.
namespace Woven.Protocol.V1;

enum MessageKind : ubyte {
  Unknown = 0,
  Hello = 1,
  Capabilities = 2,
  Authenticate = 3,
  Authenticated = 4,
  JoinSession = 5,
  LeaveSession = 6,
  SubscribeSpace = 7,
  UnsubscribeSpace = 8,
  SubscriptionAccepted = 9,
  SubscriptionRejected = 10,
  EntityEntered = 11,
  EntityLeft = 12,
  EntityState = 13,
  ReliableEvent = 14,
  SnapshotRequest = 15,
  Snapshot = 16,
  SpaceTransition = 17,
  Ping = 18,
  Pong = 19,
  ProtocolError = 20,
  InferenceRequested = 21,
  InferenceAccepted = 22,
  InferenceProgress = 23,
  InferenceStreamChunk = 24,
  InferenceCompleted = 25,
  InferenceFailed = 26,
  InferenceCancelled = 27,
  InferenceExpired = 28,
  ToolCallProposed = 29,
  ToolCallAccepted = 30,
  ToolCallRejected = 31,
  ToolCallCompleted = 32,
  RequestAdmission = 33,
  AdmissionResult = 34,
  QueueStatusRequest = 35,
  QueueHeartbeat = 36,
  QueueClaim = 37,
  QueueCancel = 38,
  QueueUpdate = 39
}

enum DeliveryClass : ubyte {
  Unknown = 0,
  ReliableOrdered = 1,
  ReliableUnordered = 2,
  LatestValue = 3,
  UnreliableSequenced = 4,
  BestEffortEvent = 5
}

enum AuthenticationScheme : ubyte {
  Unknown = 0,
  Bearer = 1,
  Development = 2
}

enum SubscriptionRejectionCode : ushort {
  Unknown = 0,
  Unauthorized = 1,
  SpaceNotFound = 2,
  CapacityExceeded = 3,
  EpochMismatch = 4
}

enum EntityLeaveReason : ubyte {
  Unknown = 0,
  Unsubscribed = 1,
  Disconnected = 2,
  Transitioned = 3,
  Removed = 4
}

enum ProtocolErrorCode : ushort {
  Unknown = 0,
  MalformedFrame = 1,
  UnsupportedVersion = 2,
  UnsupportedMessage = 3,
  AuthenticationRequired = 4,
  Unauthorized = 5,
  InvalidScope = 6,
  StaleEpoch = 7,
  SequenceRejected = 8,
  PayloadTooLarge = 9,
  RateLimited = 10,
  Internal = 11
}

enum ToolCallRejectionCode : ubyte {
  Unknown = 0,
  Stale = 1,
  Unauthorized = 2,
  InvalidArguments = 3,
  PolicyDenied = 4
}

table HelloPayload {
  min_protocol_version:ushort = 1;
  max_protocol_version:ushort = 1;
  client_name:string;
  client_version:string;
  capability_bits:ulong;
  max_frame_size:uint;
  max_payload_size:uint;
}

table CapabilitiesPayload {
  selected_protocol_version:ushort = 1;
  server_name:string;
  server_version:string;
  capability_bits:ulong;
  max_frame_size:uint;
  max_payload_size:uint;
}

table AuthenticatePayload {
  scheme:AuthenticationScheme = Unknown;
  credentials:[ubyte];
}

table AuthenticatedPayload {
  principal_id:ulong;
  assigned_entity_id:ulong;
}

table JoinSessionPayload {
  resume_token:[ubyte];
}

table LeaveSessionPayload {
  reason:string;
}

table SubscribeSpacePayload {
  // Compatibility mirror. New writers set this to Envelope.channel_id.
  channel_id:ulong;
}

table UnsubscribeSpacePayload {
  subscription_id:ulong;
}

table SubscriptionAcceptedPayload {
  subscription_id:ulong;
  accepted_space_epoch:ulong;
}

table SubscriptionRejectedPayload {
  code:SubscriptionRejectionCode = Unknown;
  reason:string;
}

table EntityEnteredPayload {
  owner_entity_id:ulong;
}

table EntityLeftPayload {
  reason:EntityLeaveReason = Unknown;
}

table SnapshotRequestPayload {
  // Compatibility mirror. New writers set this to Envelope.channel_id.
  channel_id:ulong;
  after_server_tick:ulong;
}

table SpaceTransitionPayload {
  from_space_id:ulong;
  to_space_id:ulong;
  to_space_epoch:ulong;
}

table PingPayload {
  nonce:ulong;
  sender_time_micros:ulong;
}

table PongPayload {
  nonce:ulong;
  sender_time_micros:ulong;
  responder_time_micros:ulong;
}

table ProtocolErrorPayload {
  code:ProtocolErrorCode = Unknown;
  related_message_kind:MessageKind = Unknown;
  message:string;
}

table InferenceRequestedPayload {
  capability:string;
  deadline_ms:ulong;
  input:[ubyte];
}

table InferenceAcceptedPayload {
  queued_position:uint;
}

table InferenceProgressPayload {
  percent:ubyte;
}

table InferenceStreamChunkPayload {
  sequence:uint;
  chunk:[ubyte];
  is_final:bool;
}

table InferenceCompletedPayload {
  result:[ubyte];
}

table InferenceFailedPayload {
  reason:string;
}

table InferenceCancelledPayload {
  reason:string;
}

table InferenceExpiredPayload {
  reason:string;
}

table ToolCallProposedPayload {
  tool_id:string;
  tool_version:uint;
  arguments:[ubyte];
  expected_revision:ulong;
}

table ToolCallAcceptedPayload {
  tool_id:string;
}

table ToolCallRejectedPayload {
  code:ToolCallRejectionCode = Unknown;
  reason:string;
}

table ToolCallCompletedPayload {
  new_revision:ulong;
  result:[ubyte];
}

enum AdmissionStatus : ubyte { Unknown = 0, Admitted = 1, Queued = 2, Paused = 3, Rejected = 4 }
enum AdmissionRejectionCode : ubyte { None = 0, ServerPaused = 1, QueueFull = 2, QueueDisabled = 3, AlreadyQueued = 4, InvalidIdempotencyKey = 5 }
enum QueueState : ubyte { Unknown = 0, Waiting = 1, Offered = 2, Admitted = 3, Cancelled = 4, Expired = 5, Missing = 6 }

// Scope and correlation are exclusively envelope-bound. Never expose leases/resume tokens.
table RequestAdmissionPayload { idempotency_key:string; }
table AdmissionResultPayload {
  status:AdmissionStatus;
  rejection_code:AdmissionRejectionCode;
  ticket_id:ulong;
  poll_after_ms:uint;
  ticket_remaining_ms:uint;
}
table QueueStatusRequestPayload { ticket_id:ulong; }
table QueueHeartbeatPayload { ticket_id:ulong; }
table QueueClaimPayload { ticket_id:ulong; }
table QueueCancelPayload { ticket_id:ulong; }
table QueueUpdatePayload {
  ticket_id:ulong;
  state:QueueState;
  position:uint;
  poll_after_ms:uint;
  ticket_remaining_ms:uint;
  offer_remaining_ms:uint;
}

// ControlPayload is used only by the typed control messages. EntityState,
// ReliableEvent, and Snapshot carry their application-defined bytes in
// Envelope.payload with a non-zero payload_type_id.
union ControlPayload {
  HelloPayload = 1,
  CapabilitiesPayload = 2,
  AuthenticatePayload = 3,
  AuthenticatedPayload = 4,
  JoinSessionPayload = 5,
  LeaveSessionPayload = 6,
  SubscribeSpacePayload = 7,
  UnsubscribeSpacePayload = 8,
  SubscriptionAcceptedPayload = 9,
  SubscriptionRejectedPayload = 10,
  EntityEnteredPayload = 11,
  EntityLeftPayload = 12,
  SnapshotRequestPayload = 13,
  SpaceTransitionPayload = 14,
  PingPayload = 15,
  PongPayload = 16,
  ProtocolErrorPayload = 17,
  InferenceRequestedPayload = 18,
  InferenceAcceptedPayload = 19,
  InferenceProgressPayload = 20,
  InferenceStreamChunkPayload = 21,
  InferenceCompletedPayload = 22,
  InferenceFailedPayload = 23,
  InferenceCancelledPayload = 24,
  InferenceExpiredPayload = 25,
  ToolCallProposedPayload = 26,
  ToolCallAcceptedPayload = 27,
  ToolCallRejectedPayload = 28,
  ToolCallCompletedPayload = 29,
  RequestAdmissionPayload = 30,
  AdmissionResultPayload = 31,
  QueueStatusRequestPayload = 32,
  QueueHeartbeatPayload = 33,
  QueueClaimPayload = 34,
  QueueCancelPayload = 35,
  QueueUpdatePayload = 36
}

table Envelope {
  protocol_version:ushort = 1;
  message_kind:MessageKind = Unknown;
  delivery_class:DeliveryClass = Unknown;
  namespace_id:ulong;
  session_id:ulong;
  space_id:ulong;
  entity_id:ulong;
  space_epoch:ulong;
  server_tick:ulong;
  sender_sequence:ulong;
  correlation_id:ulong;
  payload_type_id:ulong;
  payload:[ubyte];
  control:ControlPayload;
  // Appended in v1; 0 means this message is not channel-bearing.
  channel_id:ulong;
}

root_type Envelope;
file_identifier "WVN1";
file_extension "swp";
