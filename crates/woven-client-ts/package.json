{
  "name": "@signalweave/woven-client",
  "version": "0.2.0",
  "description": "Browser WebTransport client for Woven",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdharrison/woven.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "npm run typecheck",
    "format:check": "node scripts/check-format.mjs",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "node scripts/browser-e2e.mjs",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test:decode-fixture": "tsx test/decode-fixture.ts",
    "test:decode-tool-call-completed": "tsx test/decode-tool-call-completed-fixture.ts"
  },
  "dependencies": {
    "flatbuffers": "25.9.23"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
