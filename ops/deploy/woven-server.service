[Unit]
Description=Woven managed QUIC and WebTransport server
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5
ConditionFileIsExecutable=/opt/woven/current/woven-server

[Service]
Type=simple
User=this
Group=this
WorkingDirectory=/opt/woven
ExecStart=/opt/woven/current/woven-server --log-none
Environment=WOVEN_MANAGED_QUIC=1
Environment=WOVEN_QUIC_BIND=0.0.0.0:4433
Environment=WOVEN_MANAGEMENT_BIND=127.0.0.1:8080
Environment=WOVEN_ADMIN_BIND=127.0.0.1:8083
Environment=WOVEN_MANAGED_WEBTRANSPORT=1
Environment=WOVEN_WEBTRANSPORT_BIND=0.0.0.0:4434
Environment=WOVEN_WEBTRANSPORT_PATH=/webtransport
Environment=WOVEN_WEBTRANSPORT_ALLOWED_ORIGINS=https://woven.host,https://signalweave-112358.web.app
Environment=WOVEN_TLS_CERT_FILE=/etc/woven/tls/current/fullchain.pem
Environment=WOVEN_TLS_KEY_FILE=/etc/woven/tls/current/privkey.pem
Environment=WOVEN_ADMIN_TOKEN_FILE=/etc/woven/credentials/admin-token
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
KillMode=control-group
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/woven
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
